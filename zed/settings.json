{
  "file_scan_exclusions": [
    "...",
    "**/*.pyc",
    "**/.pnpm-store",
    "**/.pytest_cache",
    "**/.ruff_cache",
    "**/.venv",
    "**/__pycache__",
    "**/node_modules"
  ],
  "file_finder": {
    "include_ignored": "all"
  },
  "search": {
    "include_ignored": false
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "vim": {
    "toggle_relative_line_numbers": false
  },
  "vim_mode": true
}
